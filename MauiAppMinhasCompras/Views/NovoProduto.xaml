<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppMinhasCompras.Views.NovoProduto"
    Title="Novo Produto">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Novo Produto"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Descrição" />

            <Entry
                x:Name="txtDescricao"
                Placeholder="Digite o nome do produto" />

            <Label
                Text="Quantidade" />

            <Entry
                x:Name="txtQuantidade"
                Placeholder="Digite a quantidade"
                Keyboard="Numeric" />

            <Label
                Text="Preço" />

            <Entry
                x:Name="txtPreco"
                Placeholder="Digite o preço"
                Keyboard="Numeric" />

            <Button
                Text="Salvar"
                Clicked="OnSalvarClicked" />

            <Button
                Text="Cancelar"
                Clicked="OnCancelarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
